 b'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<!--\n  Isha appl'
 b'ication manifest.\n  requestedExecutionLevel = asInvoker  (deliberately N'
 b'OT requireAdmin).\n  Isha is a single-user desktop app: it manages the cu'
 b"rrent user's apps, modes,\n  config in %APPDATA%\\Isha, and per-user setti"
 b'ngs. None of that needs\n  Administrator rights. Requiring elevation woul'
 b'd:\n    - pop a UAC prompt on every single launch (terrible for a tray ap'
 b'p that\n      starts with Windows),\n    - make Microsoft SmartScreen wari'
 b'er of the installer,\n    - break the "start with Windows" convenience (e'
 b'levated auto-start is\n      blocked by default).\n  The few actions that '
 b'DO need elevation (e.g. a system-wide shutdown on some\n  policies) are i'
 b"nvoked through Windows' own APIs, which prompt as needed at\n  that momen"
 b't \xe2\x80\x94 the right place for the prompt, not at app start.\n  dpiAwa'
 b're / dpiAwareness keeps the Tk windows crisp on high-DPI displays.\n-->\n<'
 b'assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">'
 b'\n  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">\n    <security>\n '
 b'     <requestedPrivileges>\n        <requestedExecutionLevel level="asInv'
 b'oker" uiAccess="false"/>\n      </requestedPrivileges>\n    </security>\n  '
 b'</trustInfo>\n  <application xmlns="urn:schemas-microsoft-com:asm.v3">\n  '
 b'  <windowsSettings>\n      <dpiAware xmlns="http://schemas.microsoft.com/'
 b'SMI/2005/WindowsSettings">true/pm</dpiAware>\n      <dpiAwareness xmlns="'
 b'http://schemas.microsoft.com/SMI/2016/WindowsSettings">permonitorv2,permonit'
 b'or</dpiAwareness>\n    </windowsSettings>\n  </application>\n  <!-- Declare'
 b' Windows 10/11 compatibility so version APIs report correctly. -->\n  <co'
 b'mpatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">\n    <app'
 b'lication>\n      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"'
 b'/>\n      <!-- Win 10/11 -->\n    </application>\n  </compatibility>\n  <dep'
 b'endency>\n    <dependentAssembly>\n      <assemblyIdentity type="win32" na'
 b'me="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitectu'
 b're="*" publicKeyToken="6595b64144ccf1df" language="*"/>\n    </dependentA'
 b'ssembly>\n  </dependency>\n</assembly>',
